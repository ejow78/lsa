# ==========================================
# CONFIGURACIÓN DE DISCORD
# ==========================================
DISCORD_TOKEN=tu_token_del_bot_aqui
CLIENT_ID=tu_application_client_id_aqui
GUILD_ID=id_de_tu_servidor_de_discord

# ==========================================
# CANALES Y ROLES DE DISCORD
# ==========================================
STATUS_CHANNEL_ID=id_del_canal_de_estado_en_vivo
ALERT_CHANNEL_ID=id_del_canal_de_alertas
ALERT_ROLE_ID=id_del_rol_para_mencionar

# ==========================================
# SERVIDOR ASSETTO CORSA / EMPEROR SERVER
# ==========================================
EMPEROR_IP_OR_DOMAIN=127.0.0.1
EMPEROR_HTTP_PORT=8772
# Puerto HTTP del acServer para unirse desde Content Manager (si es igual a EMPEROR_HTTP_PORT, puedes dejar el mismo)
AC_JOIN_HTTP_PORT=8081

# ==========================================
# MONITOR Y MODO SIMULACIÓN (TESTING)
# ==========================================
POLLING_INTERVAL_SECONDS=30
# Pon MOCK_MODE=true para probar en Discord sin tener aún acceso al servidor Emperor real
MOCK_MODE=true
